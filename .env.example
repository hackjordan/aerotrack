# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env ne doit jamais être versionné.

# Clé secrète Django : générer une valeur avec
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=a-remplacer

# True uniquement sur le poste de développement
DJANGO_DEBUG=False

# Noms ou adresses IP du serveur sur l'intranet, séparés par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# True si le site est servi en HTTPS (par exemple sur PythonAnywhere)
DJANGO_HTTPS=False

# Chemin du fichier de base de données SQLite (relatif au dossier du projet)
SQLITE_PATH=db.sqlite3
